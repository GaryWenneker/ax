# ax Command Center configuration
# Seeded by `ax init` when missing. Edit org/project/repo_id for draft PRs.

[ship]
target_branch = "main"
web_port = 7070

[quality_gate]
steps = ["index", "tia", "tests", "sonar", "policy"]
index_mode = "incremental"  # incremental | full

[quality_gate.tests]
runner = "cargo test"

[remote]
provider = "azure_devops"  # or "github"

[remote.azure_devops]
org = "your-org"
project = "your-project"
repo_id = "your-repo-uuid"
token_env = "AZDO_PAT"

# [remote.github]
# owner = "your-org"
# repo = "your-repo"
# token_env = "GITHUB_TOKEN"

[sonar]
enabled = false
host = "http://localhost:9000"
project_key = "your-project"
token_env = "SONAR_TOKEN"
scanner_path = "sonar-scanner"
podman_container = "sonarqube"
container_runtime = "auto"  # auto | podman | docker
scan_mode = "incremental"   # incremental | full
admin_user = "admin"
admin_password = "admin"
# PostgreSQL-backed stack: sonarqube:community + postgres:16 sidecar (4 GB RAM, 2 GB CE heap).
# Install upgrades legacy embedded-H2 containers automatically (re-run Setup project & token after upgrade).

[ui]
show_savings = true
show_agent_terminal = true
# Write inbound args, enrichment steps, and outbound MCP payloads to the
# ax MCP Output channel (stderr). Off by default — never alters tool responses.
verbose_mcp = false

# Map git blame emails to AzDO reviewer identities (email or user GUID)
# [reviewers]
# "dev@example.com" = "user@dev.azure.com"
