---
import MinimalDownload from './MinimalDownload.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<a class="ax-skip" href="#main">Skip to content</a>
<div class="ax-page">
  <div class="ax-halftone" aria-hidden="true">
    <div class="ax-halftone-grid">
      <div class="ax-halftone-dots ax-halftone-screen-one"></div>
      <div class="ax-halftone-dots ax-halftone-screen-two"></div>
      <div class="ax-halftone-dots ax-halftone-screen-three"></div>
    </div>
  </div>

  <header class="ax-header">
    <a class="ax-wordmark" href={base + '/'} aria-label="Ax home">Ax<span>_</span></a>
    <nav class="ax-navigation" aria-label="Primary navigation">
      <a href={base + '/getting-started/introduction/'}>Docs ↗</a>
      <a href="https://github.com/GaryWenneker/ax" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </nav>
  </header>

  <main class="ax-main" id="main">
    <div class="ax-content">
      <p class="ax-eyebrow">LOCAL-FIRST / OPEN SOURCE / DEVELOPER TOOLING</p>
      <div class="ax-display-word" aria-hidden="true">Ax<span>_</span></div>
      <h1 class="ax-headline"><span>Your context.</span><span>Your rules.</span><span class="ax-headline-accent">Your control.</span></h1>
      <div class="ax-feature-strip" aria-label="Core capabilities">
        <span>Context</span><span>Rules</span><span>Control</span><span>One native binary</span>
      </div>
      <p class="ax-explainer">
        Local-first code intelligence, persistent memory, MCP integration and
        policy-driven development. One native binary.
      </p>
      <MinimalDownload />
    </div>
  </main>

  <footer class="ax-footer">
    <span>© Ax · Open source · MIT · Native Rust</span>
    <div class="ax-footer-links">
      <a href={base + '/getting-started/installation/'}>Install guide</a>
      <a href="https://github.com/GaryWenneker/ax/releases/latest" target="_blank" rel="noopener noreferrer">Releases ↗</a>
    </div>
  </footer>
</div>
