---
import { AX_FULL_NAME, AX_TAGLINE } from '../lib/brand';
import MinimalDownload from './MinimalDownload.astro';
import MotionControl from './MotionControl.astro';
import ScrollReveal from './ScrollReveal.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<a class="ax-skip" href="#main">Skip to content</a>
<div class="ax-page">
  <div class="ax-halftone" aria-hidden="true">
    <div class="ax-halftone-grid ax-halftone-soft">
      <div class="ax-halftone-dots ax-halftone-screen-one"></div>
      <div class="ax-halftone-dots ax-halftone-screen-two"></div>
      <div class="ax-halftone-dots ax-halftone-screen-three"></div>
    </div>
    <div class="ax-halftone-grid ax-halftone-sharp">
      <div class="ax-halftone-dots ax-halftone-screen-one"></div>
      <div class="ax-halftone-dots ax-halftone-screen-two"></div>
      <div class="ax-halftone-dots ax-halftone-screen-three"></div>
    </div>
  </div>

  <header class="ax-header">
    <a class="ax-wordmark" data-ax-reveal href={base + '/'} aria-label="Ax home">Ax<span>_</span></a>
    <nav class="ax-navigation" data-ax-reveal aria-label="Primary navigation">
      <a href={base + '/getting-started/introduction/'}>Docs ↗</a>
      <a href="https://github.com/GaryWenneker/ax" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <MotionControl />
    </nav>
  </header>

  <main class="ax-main" id="main">
    <div class="ax-content">
      <p class="ax-eyebrow" data-ax-reveal>LOCAL-FIRST / OPEN SOURCE / DEVELOPER TOOLING</p>
      <div class="ax-display-word" data-ax-reveal aria-hidden="true">Ax<span>_</span></div>
      <p class="ax-full-name" data-ax-reveal>{AX_FULL_NAME}</p>
      <h1 class="ax-headline" aria-label={AX_TAGLINE}><span>The context layer</span><span class="ax-headline-accent">for AI agents</span></h1>
      <div class="ax-feature-strip" data-ax-reveal aria-label="Core capabilities">
        <span>Context</span><span>Rules</span><span>Control</span><span>One native binary</span>
      </div>
      <p class="ax-explainer" data-ax-reveal>
        Local-first code intelligence, persistent memory, MCP integration and
        policy-driven development. One native binary.
      </p>
      <MinimalDownload />
    </div>
  </main>

  <footer class="ax-footer">
    <span data-ax-reveal>© Ax · Open source · MIT · Native Rust</span>
    <div class="ax-footer-links" data-ax-reveal>
      <a href={base + '/getting-started/installation/'}>Install guide</a>
      <a href="https://github.com/GaryWenneker/ax/releases/latest" target="_blank" rel="noopener noreferrer">Releases ↗</a>
    </div>
  </footer>
</div>

<ScrollReveal />
