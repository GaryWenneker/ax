---
/** Sparse, build-time mosaic. Mixed footprints share a lattice without overlaps. */
interface Props {
  variant?: "hero" | "deployment";
}
const { variant = "hero" } = Astro.props;
const palette = ["#74949d", "#849b8b", "#b79a7b", "#a6b4b3"];
const patches =
  variant === "hero"
    ? [
        { x: 83, y: 24, cols: 12, rows: 10, unit: 22, seed: 7 },
        { x: 94, y: 75, cols: 8, rows: 7, unit: 12, seed: 71 },
        { x: 9, y: 86, cols: 11, rows: 5, unit: 9, seed: 137 },
      ]
    : [
        { x: 12, y: 12, cols: 14, rows: 6, unit: 10, seed: 213 },
        { x: 90, y: 29, cols: 10, rows: 9, unit: 26, seed: 319 },
      ];
function random(n: number) {
  const v = Math.sin(n * 127.1 + 43.31) * 43758.5453;
  return v - Math.floor(v);
}
const tiles = patches.flatMap((patch) => {
  const occupied = new Set<string>();
  const cells = [];
  for (let row = 0; row < patch.rows; row++)
    for (let col = 0; col < patch.cols; col++) {
      const seed = patch.seed + row * patch.cols + col;
      if (occupied.has(`${col},${row}`) || random(seed) > 0.43) continue;
      const shape = random(seed + 921);
      let w = shape > 0.8 ? 3 : shape > 0.5 ? 2 : 1;
      let h = shape > 0.66 ? 2 : 1;
      w = Math.min(w, patch.cols - col);
      h = Math.min(h, patch.rows - row);
      if (
        Array.from({ length: w * h }, (_, i) =>
          occupied.has(`${col + (i % w)},${row + Math.floor(i / w)}`),
        ).some(Boolean)
      ) {
        w = 1;
        h = 1;
      }
      for (let dy = 0; dy < h; dy++)
        for (let dx = 0; dx < w; dx++) occupied.add(`${col + dx},${row + dy}`);
      cells.push({
        x: `calc(${patch.x}% + ${(col - patch.cols / 2) * patch.unit}px)`,
        y: `calc(${patch.y}% + ${(row - patch.rows / 2) * patch.unit}px)`,
        w: w * patch.unit - 3,
        h: h * patch.unit - 3,
        color: palette[Math.floor(random(seed + 51) * palette.length)],
        peak: (0.12 + random(seed + 107) * 0.26).toFixed(2),
        duration: (7 + random(seed + 401) * 10).toFixed(2),
        delay: (-random(seed + 79) * 17).toFixed(2),
      });
    }
  return cells;
});
---

<div class:list={["pixel-field", variant]} aria-hidden="true">
  {tiles.map((tile) => (
    <span
      style={`--x:${tile.x};--y:${tile.y};--w:${tile.w}px;--h:${tile.h}px;--color:${tile.color};--peak:${tile.peak};--duration:${tile.duration}s;--delay:${tile.delay}s`}
    />
  ))}
</div>
<style>
  .pixel-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 15%,
      #000 82%,
      transparent
    );
  }
  span {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    height: var(--h);
    background: var(--color);
    opacity: 0.12;
    animation: assemble var(--duration) steps(6, end) var(--delay) infinite;
  }
  @keyframes assemble {
    0%,
    100% {
      opacity: 0.025;
      transform: translateY(3px);
    }
    35%,
    55% {
      opacity: var(--peak);
      transform: translateY(0);
    }
    80% {
      opacity: 0.06;
      transform: translateY(0);
    }
  }
  :global(html[data-ax-motion="paused"]) span {
    animation-play-state: paused;
  }
  @media (max-width: 700px) {
    .hero {
      opacity: 0.4;
      mask-image: linear-gradient(90deg, transparent 35%, #000 100%);
    }
    .deployment {
      opacity: 0.4;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    span {
      animation: none;
      opacity: 0.12;
    }
  }
</style>
