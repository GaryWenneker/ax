---
import Default from '@astrojs/starlight/components/Head.astro';
import { kickerFor, ogImagePath } from '../lib/og-card.mjs';

const route = Astro.locals.starlightRoute;
const site = Astro.site ?? new URL('https://getax.wenneker.io');
const image = new URL(ogImagePath(Astro.url.pathname), site).href;
const pageTitle = route.entry?.data?.title ?? 'ax';
const ogTitle = pageTitle === 'ax' ? 'ax' : `${pageTitle} | ax`;
const description = route.entry?.data?.description ?? '';
const kicker = kickerFor(Astro.url.pathname);
---

<Default {...Astro.props} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content="article" />
<meta property="og:url" content={Astro.url.href} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${kicker}: ${pageTitle}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:image" content={image} />
