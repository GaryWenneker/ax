---
/**
 * Starlight Header override — default chrome + azure CSS waves hanging below.
 * Glass/backdrop lives on the inner bar only so iOS does not clip the crest.
 * BokehField mounts once and moves to document.body (Focus Features disks).
 */
import Default from '@astrojs/starlight/components/Header.astro';
import HeaderWaves from './HeaderWaves.astro';
import BokehField from './BokehField.astro';
---

<BokehField />
<div class="ax-header-wrap">
	<div class="ax-header-glass">
		<Default {...Astro.props} />
	</div>
	<HeaderWaves variant="docs" />
</div>

<style>
	.ax-header-wrap {
		position: relative;
		isolation: isolate;
		overflow: visible;
		width: 100%;
		height: 100%;
		z-index: var(--sl-z-index-navbar, 10);
	}
	.ax-header-glass {
		position: relative;
		z-index: 1;
		height: 100%;
		display: flex;
		align-items: center;
		/* Fade into HeaderWaves — no hard bar edge */
		background: linear-gradient(
			to bottom,
			rgba(6, 6, 16, 0.75) 0%,
			rgba(6, 6, 16, 0.45) 65%,
			transparent 100%
		);
		-webkit-backdrop-filter: blur(20px) saturate(140%);
		backdrop-filter: blur(20px) saturate(140%);
		-webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 72%, transparent 100%);
		mask-image: linear-gradient(to bottom, #000 0%, #000 72%, transparent 100%);
	}
	.ax-header-wrap :global(.header) {
		position: relative;
		z-index: 1;
		width: 100%;
		background: transparent !important;
		border-bottom-color: transparent !important;
		-webkit-backdrop-filter: none !important;
		backdrop-filter: none !important;
	}
	.ax-header-wrap :global(.header > *) {
		position: relative;
		z-index: 1;
	}
	:global(html[data-theme='light']) .ax-header-glass {
		background: rgba(36, 41, 47, 0.92);
	}
</style>
