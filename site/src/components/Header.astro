---
/** Shared, quiet documentation chrome; search and mobile navigation stay native. */
import '../styles/minimal-home.css';
import Default from "@astrojs/starlight/components/Header.astro";
---

<div class="ax-doc-moire ax-landing" aria-hidden="true">
  <div class="ax-halftone"><div class="ax-halftone-grid">
    <span class="ax-halftone-dots ax-halftone-screen-one"></span>
    <span class="ax-halftone-dots ax-halftone-screen-two"></span>
    <span class="ax-halftone-dots ax-halftone-screen-three"></span>
  </div></div>
</div>
<Default {...Astro.props} />
