---
// Starlight header: AX dot logo + wordmark + current release tag.
import { AX_VERSION } from '../lib/version';
import { AX_FULL_NAME } from '../lib/brand';

const { siteTitle } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<a
	href={`${base}/`}
	class="cg-site-title"
	translate="no"
	aria-label={`${siteTitle} ${AX_VERSION}, ${AX_FULL_NAME}`}
>
	<span class="cg-site-title__wordmark">Ax<span>_</span></span>
		<span class="cg-site-title__version">{AX_VERSION}</span>
</a>

<style>
	.cg-site-title {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-family: "Oxanium Variable", "Oxanium", var(--sl-font);
		font-weight: 650;
		font-size: 1.3rem;
		letter-spacing: -0.025em;
		line-height: 1;
		color: var(--cg-ink);
		text-decoration: none;
		white-space: nowrap;
	}
	.cg-site-title:hover {
		color: var(--cg-ink);
	}
	.cg-site-title__wordmark {
		color: #f0f3ed;
		font-size: 1.65rem;
		line-height: 1;
		letter-spacing: -0.095em;
	}
	.cg-site-title__wordmark > span { color: #b9ff6a; }
	.cg-site-title__version {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--cg-ink-2);
		border: 1px solid var(--cg-rule);
		padding: 0.15rem 0.45rem;
		line-height: 1.2;
	}
</style>
