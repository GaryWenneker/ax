---
import { cloudDeploys } from '../lib/cloud-deploy.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const servers = cloudDeploys.filter((d) => d.kind === 'MCP server');
---
<nav class="ax-cloud-deploy" aria-label="Deploy the headless build to the cloud">
  <a class="ax-cloud-deploy-title" href={base + '/guides/headless-linux/#deploy-to-the-cloud'}>Deploy headless to the cloud</a>
  <div class="ax-deploy-row">
    {servers.map((d) => (
      <a class="ax-deploy" href={d.url} target="_blank" rel="noopener noreferrer" data-provider={d.provider} data-ax-deploy={d.id}>
        {d.label}
      </a>
    ))}
  </div>
</nav>
