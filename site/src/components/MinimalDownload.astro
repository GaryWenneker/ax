---
import { platformIcons } from '../lib/agent-icons';
import { INSTALL_UNIX } from '../lib/install-command.ts';
import { AX_RELEASE_VERSION } from '../lib/version';

const osOptions = [
  { id:'macos', label:'macOS', icon: platformIcons.macOS },
  { id:'linux', label:'Linux', icon: platformIcons.Linux },
  { id:'windows', label:'Windows', icon: platformIcons.Windows },
  { id:'wsl2', label:'WSL2', icon: platformIcons.Linux },
];
---
<div class="ax-download" data-ax-downloader data-ax-reveal>
  <div class="ax-download-row">
    <button class="ax-download-primary" type="button" data-ax-download>
      <span class="ax-os-icon" data-ax-main-icon set:html={platformIcons.macOS} />
      <span data-ax-download-label>Copy macOS install command</span>
      <span class="ax-download-glyph" aria-hidden="true">⧉</span>
    </button>
    <div class="ax-download-controls">
      <button class="ax-other-platforms" type="button" data-ax-platform-toggle aria-expanded="false" aria-controls="ax-platform-menu">
        Other platforms <span aria-hidden="true">⌄</span>
      </button>
      <div class="ax-platform-panel" id="ax-platform-menu" data-ax-platform-panel hidden>
        <p class="ax-panel-title">Select development platform</p>
        <div class="ax-platform-options" role="group" aria-label="Operating system">
          {osOptions.map(os => (
            <button type="button" data-ax-os={os.id} aria-pressed={os.id === 'macos' ? 'true' : 'false'}>
              <span class="ax-os-icon" set:html={os.icon} /> {os.label}
            </button>
          ))}
        </div>
        <p class="ax-platform-help" data-ax-platform-help>The installer selects the correct CPU architecture.</p>
      </div>
    </div>
  </div>
  <div id="ax-install-command" class="ax-install-command" hidden data-ax-install-panel>
    <p data-ax-install-instruction>Copy and run in Terminal.</p>
    <code data-ax-install-code>{INSTALL_UNIX}</code>
    <button type="button" data-ax-install-copy>Copy install command</button>
    <p data-ax-install-status role="status" aria-live="polite"></p>
    <p>Your browser cannot run terminal commands. Paste the command into your terminal and press Enter.</p>
  </div>
  <noscript><p>Run in macOS, Linux or WSL2 Terminal: <code>{INSTALL_UNIX}</code>. For Windows PowerShell, see the <a href="/getting-started/installation/#windows">installation guide</a>.</p></noscript>
  <p class="ax-download-caption" aria-live="polite">
    <span data-ax-platform-label>macOS · Terminal</span><span aria-hidden="true">·</span>
    <span>Latest release: v{AX_RELEASE_VERSION.replace(/^v/, '')}</span><span aria-hidden="true">·</span>
    <a href="https://github.com/GaryWenneker/ax/releases/latest" target="_blank" rel="noopener noreferrer">Other files ↗</a>
  </p>
</div>
<script>
  import { mountMinimalDownload } from '../scripts/minimal-download';
  mountMinimalDownload();
</script>