---
import "@fontsource-variable/archivo";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "../styles/theme.css";
import "../styles/home-cinematic.css";
import "../styles/landscape-svg.css";
import "../styles/live-terminal.css";
import "../styles/ares-identity.css";
import "../styles/home-interaction.css";
import CinematicHome from "../components/CinematicHome.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import { DOCS_SITE } from "../lib/brand";
import { ogImagePath } from "../lib/og-card.mjs";
import { pageLockScript } from "../lib/page-lock";

const tagline = "Understand code. Preserve context. Guide every agent. Ax brings code intelligence, durable memory, policy, MCP and quality gates into one developer workflow.";
const ogImage = new URL(ogImagePath("/"), DOCS_SITE).href;
const pageLock = pageLockScript();
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={pageLock} />
    <link rel="icon" href="/favicon.svg" />
    <title>Ax — Understand code. Preserve context. Guide every agent.</title>
    <meta name="description" content={tagline} />
    <meta property="og:title" content="Ax — Understand code. Preserve context. Guide every agent." />
    <meta property="og:description" content={tagline} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#030c16" />
  </head>
  <body class="signal-site">
    <CinematicHome />
    <ScrollReveal />
  </body>
</html>
