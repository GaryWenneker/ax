---
import "@fontsource-variable/archivo";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "../styles/theme.css";
import LogoMark from "../components/LogoMark.astro";
import { agents, agentIcons } from "../lib/agent-icons";
import PixelField from "../components/PixelField.astro";
import MotionControl from "../components/MotionControl.astro";
import { getStarsLabel } from "../lib/github";
import { AX_VERSION, AX_RELEASE_VERSION } from "../lib/version";
import { AX_FULL_NAME, DOCS_SITE } from "../lib/brand";
import { ogImagePath } from "../lib/og-card.mjs";
import { INSTALL_UNIX, installBootScript } from "../lib/install-command";
import { pageLockScript } from "../lib/page-lock";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const repo = "https://github.com/GaryWenneker/ax";
const stars = await getStarsLabel();
const installBoot = installBootScript();
const pageLock = pageLockScript();

const TAGLINE =
  "Local code graph, persistent memory, policy, and quality gates for AI coding agents.";
const ogImage = new URL(ogImagePath("/"), DOCS_SITE).href;

const pipeline = [
  {
    step: "01",
    title: "Index",
    cmd: "ax index",
    body: "Tree-sitter parses 20+ languages plus Markdown, PDF, and Office docs into a local knowledge graph — symbols, callers, callees, blast radius.",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="19" y="4" width="10" height="10"/><rect x="4" y="34" width="10" height="10"/><rect x="34" y="34" width="10" height="10"/><path d="M24 14v10M9 34v-10h30v10M24 24v10"/></svg>`,
  },
  {
    step: "02",
    title: "Remember",
    cmd: "ax remember",
    body: "Hybrid memory vault with git auto-capture. Recalled via MCP preflight on every agent turn.",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 10h24v28H12z"/><path d="M18 18h12M18 26h8M18 34h10"/></svg>`,
  },
  {
    step: "03",
    title: "Ship",
    cmd: "ax ship",
    body: "Quality gates (optional SonarQube step), test-impact, ax ship --ci, and draft PRs from the Command Center on your machine.",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 36V18l16-10 16 10v18"/><path d="M18 36V24h12v12M22 28h4"/></svg>`,
  },
];

const pillars = [
  {
    title: "Smart Output",
    body: "Compact agent text and lean metadata, full context on demand, and required policy preserved across turns.",
    href: "/guides/smart-output/",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="8" y="10" width="32" height="28"/><path d="M16 18h16M16 24h10M16 30h14"/></svg>`,
  },
  {
    title: "Remote MCP",
    body: "Connect ChatGPT and other IDEs to your Ax through HTTPS and OAuth, with explicit access to each project.",
    href: "/guides/remote-mcp/",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="6" y="10" width="14" height="24"/><rect x="28" y="10" width="14" height="24"/><path d="M20 22h8M12 29h2M34 29h2"/></svg>`,
  },
  {
    title: "Knowledge graph",
    body: "Query indexed symbols, callers, callees, call paths, and change impact through MCP.",
    href: "/core-concepts/knowledge-graph",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="19" y="4" width="10" height="10"/><rect x="4" y="34" width="10" height="10"/><rect x="34" y="34" width="10" height="10"/><path d="M24 14v10M9 34v-10h30v10M24 24v10"/></svg>`,
  },
  {
    title: "Memory vault",
    body: "Decisions, fixes, and conventions with hybrid search. Editable in Command Center, injected at preflight.",
    href: "/guides/memory",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 10h24v28H12z"/><path d="M18 18h12M18 26h8M18 34h10"/></svg>`,
  },
  {
    title: "Policy engine",
    body: "Composable language stacks, a configurable rules folder, layered rules and skills, git pack sync, and built-in packs — matched per turn.",
    href: "/guides/policy-engine",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="6" y="8" width="36" height="32"/><path d="M14 18h20M14 26h14M14 34h18"/></svg>`,
  },
  {
    title: "Command Center",
    body: "ax web / ax share — graph browser, MCP Logging / Quality, PWA, live action stream, policy editors, and memory vault.",
    href: "/guides/command-center",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 36V18l16-10 16 10v18"/><path d="M18 36V24h12v12M22 28h4"/></svg>`,
  },
  {
    title: "Architecture insights",
    body: "Leiden communities, god nodes, and surprising connections — plus Graph Start here, an optional Domain overlay, a Markdown report, and confidence-tagged edges.",
    href: "/guides/architecture-insights",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="24" cy="12" r="5"/><circle cx="10" cy="36" r="5"/><circle cx="38" cy="36" r="5"/><circle cx="26" cy="30" r="3"/><path d="M22 16 12 32M27 15l9 18M22 13 15 34M28 27l7 6"/></svg>`,
  },
  {
    title: "MCP quality loop",
    body: "Verbose traces, live Logging, and a scored Quality slide-out that turns Explore-before-Grep waste into a Copy fixpack.",
    href: "/guides/mcp-quality",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 34V14h32v20"/><path d="M14 22h8M14 28h20M28 18l6 6-6 6"/></svg>`,
  },
  {
    title: "Context cache",
    body: "Oversized MCP replies stay on disk. Preflight shows a session ledger and ids, and ax_expand returns the original text.",
    href: "/guides/token-savings/#context-cache",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="8" y="10" width="32" height="28"/><path d="M16 20h16M16 28h10"/></svg>`,
  },
];

pillars.push({
  title: "Standalone & replicas",
  body: "Run a primary server and connect replicas. Manage team access, client tokens, and nodes in Settings.",
  href: "/guides/standalone-ax/",
  icon: '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="16" y="4" width="16" height="12"/><rect x="4" y="32" width="16" height="12"/><rect x="28" y="32" width="16" height="12"/><path d="M24 16v8M12 32v-8h24v8"/></svg>',
});
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={pageLock} />
    <link rel="icon" href={`${base}/logo.png`} />
    <title>ax — Graph it. Remember it. Ship it.</title>
    <meta name="description" content={TAGLINE} />
    <meta
      property="og:title"
      content="ax — Graph it. Remember it. Ship it."
    />
    <meta property="og:description" content={TAGLINE} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#101417" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="nav">
      <a class="wordmark" href={`${base}/`} aria-label={`${AX_FULL_NAME} home`}>
        <LogoMark size="md" />
      </a>
      <nav aria-label="Main navigation">
        <a class="desktop-link" href="#features">
          Platform
        </a>
        <a class="desktop-link" href="#deployment">
          Deployment
        </a>
        <a href={`${base}/getting-started/introduction/`}>Docs</a>
        <a href={repo}>
          GitHub{stars && <span class="stars"> · {stars} ★</span>}
        </a>
        <MotionControl />
      </nav>
    </header>
    <main id="main">
      <section class="hero">
        <PixelField variant="hero" />
        <div class="hero-content">
          <div class="eyebrow">
            <span class="status-square" aria-hidden="true"></span> CODE GRAPH / MEMORY / POLICY / MCP
          </div>
          <h1>
            Graph it. Remember it.<br />
            Ship it<span class="accent">.</span>
          </h1>
          <p class="hero-lede">
            A local code graph, persistent memory, and project rules for your AI coding agents.
          </p>
          <p class="hero-detail">
            Ax indexes symbols and call relationships, recalls decisions across sessions,
            and supplies applicable rules through MCP. Run quality gates before a PR.
            Use one local binary, or connect replicas to your own Primary.
          </p>
          <div class="actions">
            <a class="btn primary" href={`${base}/getting-started/quickstart/`}>
              Get started <span aria-hidden="true">↗</span>
            </a>
            <a class="btn secondary" href="#features">
              Explore the platform <span aria-hidden="true">↓</span>
            </a>
          </div>
          <div class="release">
            <span>{AX_VERSION}</span>
            <span>Open source · MIT</span>
            <span>macOS / Linux / Windows</span>
          </div>
          {AX_VERSION !== AX_RELEASE_VERSION && (
            <p class="version-note">
              Latest download:{" "}
              <a href={`${repo}/releases/latest`}>{AX_RELEASE_VERSION}</a> ·{" "}
              <a href={`${base}/getting-started/installation/#build-from-main`}>
                Build {AX_VERSION} from main
              </a>
            </p>
          )}
        </div>
        <div class="hero-annotation" aria-hidden="true">
          <span>01 / CONTEXT LAYER</span>
          <span>LOCAL BY DEFAULT</span>
        </div>
      </section>
      <section class="integrations" aria-label="Compatible agents">
        <p class="eyebrow">WORKS WITH YOUR TOOLS</p>
        <div class="agent-list">
          {agents.map((name) => (
            <span class="agent">
              <span class="agent-icon" set:html={agentIcons[name]} />
              {name}
            </span>
          ))}
        </div>
        <a href={`${base}/reference/integrations/`}>All integrations ↗</a>
      </section>
      <section class="platform-section section" id="features">
        <div class="section-heading">
          <p class="eyebrow">01 / THE PLATFORM</p>
          <h2>
            What Ax does.
          </h2>
          <p>
            Code navigation, durable project knowledge, and policy enforcement through MCP.
          </p>
        </div>
        <div class="feature-grid">
          {pillars.map((p, i) => (
            <a class="feature" href={`${base}${p.href}`}>
              <div class="feature-top">
                <span class="number">{String(i + 1).padStart(2, "0")}</span>
                <span class="feature-icon" set:html={p.icon} />
                <span class="feature-arrow" aria-hidden="true">
                  ↗
                </span>
              </div>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
              <span class="feature-link">Read the guide</span>
            </a>
          ))}
        </div>
      </section>
      <section class="workflow section" id="workflow">
        <div class="section-heading">
          <p class="eyebrow">02 / HOW IT FITS</p>
          <h2>Index. Remember. Ship.</h2>
          <p>Three commands to index code, save knowledge, and run quality gates.</p>
        </div>
        <div class="workflow-grid">
          {pipeline.map((item) => (
            <article>
              <span class="number">{item.step}</span>
              <h3>{item.title}</h3>
              <code>{item.cmd}</code>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </section>
      <section class="product section" id="command-center">
        <div class="section-heading">
          <p class="eyebrow">03 / COMMAND CENTER</p>
          <h2>
            Inspect the graph, memory, and rules.
          </h2>
          <p>
            Browse code relationships, edit memory and policy, inspect agent
            activity, and manage access from one interface.
          </p>
          <a class="text-link" href={`${base}/guides/command-center/`}>
            Take the walkthrough ↗
          </a>
        </div>
        <figure>
          <a href={`${base}/guides/command-center/`}>
            <img
              src={`${base}/screenshots/cc-graph-dark.png`}
              alt="Ax Command Center showing code relationships in the knowledge graph"
              width="1440"
              height="900"
              loading="lazy"
            />
          </a>
          <figcaption>
            Command Center / Knowledge graph{" "}
            <span>Actual product interface</span>
          </figcaption>
        </figure>
        <div class="product-links">
          <a href={`${base}/guides/memory/`}>Memory vault ↗</a>
          <a href={`${base}/guides/policy-engine/`}>Rules & skills ↗</a>
          <a href={`${base}/guides/mcp-quality/`}>Agent activity ↗</a>
          <a href={`${base}/guides/standalone-ax/`}>Team & client access ↗</a>
        </div>
      </section>
      <section class="deployment section" id="deployment">
        <PixelField variant="deployment" />
        <div class="section-heading">
          <p class="eyebrow">04 / RUN IT YOUR WAY</p>
          <h2>
            On your machine.
            <br />
            Or on your infrastructure.
          </h2>
          <p>
            Start with a local project. Add a shared server when your workflow
            needs one.
          </p>
        </div>
        <div class="deployment-grid">
          <a href={`${base}/getting-started/installation/`}>
            <span class="number">LOCAL</span>
            <h3>One developer. One binary.</h3>
            <p>
              Index your project, connect an IDE through MCP, and keep your
              graph and memory on your own machine.
            </p>
            <span class="text-link">Local installation ↗</span>
          </a>
          <a href={`${base}/guides/standalone-ax/`}>
            <span class="number">SELF-HOSTED</span>
            <h3>A shared primary. Connected replicas.</h3>
            <p>
              Run Ax as a standalone server or in Docker. Configure the primary,
              register replicas, and manage team, client, and node access.
            </p>
            <span class="text-link">Server & replica setup ↗</span>
          </a>
          <a href={`${base}/guides/remote-mcp/`}>
            <span class="number">REMOTE MCP</span>
            <h3>Your context. Available remotely.</h3>
            <p>
              Connect external agents over HTTPS with OAuth and explicit project
              access. You choose where the server runs.
            </p>
            <span class="text-link">Remote connection guide ↗</span>
          </a>
        </div>
      </section>
      <section class="start section" id="start">
        <div>
          <p class="eyebrow">GET STARTED</p>
          <h2>
            Install Ax and connect MCP.
          </h2>
          <p>Install Ax, index a project, and connect your agent.</p>
          <a class="btn primary" href={`${base}/getting-started/quickstart/`}>
            Follow the quickstart ↗
          </a>
        </div>
        <div class="install-panel">
          <div class="install-head">
            <span>TERMINAL / INSTALL</span>
            <span aria-hidden="true">_</span>
          </div>
          <div class="install" data-install={INSTALL_UNIX}>
            <code>{INSTALL_UNIX}</code>
            <button
              class="copy"
              type="button"
              aria-label="Copy install command"
            >
              Copy
            </button>
          </div>
          <p class="copy-status" role="status" aria-live="polite"></p>
          <p class="install-note">
            Then follow the guide to index your project and connect MCP.
          </p>
          <a href={`${base}/getting-started/installation/`}>
            Installation options ↗
          </a>
        </div>
        <script is:inline set:html={installBoot} />
      </section>
    </main>
    <footer>
      <a href={`${base}/`} aria-label="ax home">
        <LogoMark size="sm" />
      </a>
      <p>Code graph · Memory · Policy · MCP</p>
      <nav aria-label="Footer">
        <a href={`${base}/getting-started/introduction/`}>Documentation</a>
        <a href={repo}>GitHub</a>
        <a href={`${repo}/blob/main/LICENSE`}>MIT license</a>
      </nav>
    </footer>
    <script>
      const wrap = document.querySelector<HTMLElement>(".install");
      const button = wrap?.querySelector<HTMLButtonElement>(".copy");
      const status = document.querySelector<HTMLElement>(".copy-status");
      button?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(wrap?.dataset.install || "");
          if (status) status.textContent = "Install command copied.";
        } catch {
          if (status) status.textContent = "Select and copy the command above.";
        }
      });
    </script>
  </body>
</html>
<style>
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
  }
  :global(body) {
    margin: 0;
    background: var(--cg-paper);
    font-family: var(--sl-font);
    color: var(--cg-ink);
  }
  :global(*) {
    box-sizing: border-box;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  .nav {
    height: 80px;
    padding: 0 max(24px, calc((100vw - 1280px) / 2));
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--cg-rule);
    background: #101417;
    position: relative;
    z-index: 5;
  }
  .nav nav {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 13px;
  }
  .nav a:hover {
    color: var(--cg-accent);
  }
  .stars {
    color: var(--cg-ink-2);
  }
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 590px;
    padding: 70px max(24px, calc((100vw - 1200px) / 2)) 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 880px;
  }
  .eyebrow,
  .number {
    font: 500 11px/1.6 var(--sl-font-mono);
    letter-spacing: 0.09em;
    color: var(--cg-ink-2);
    margin: 0 0 28px;
  }
  .status-square {
    display: inline-block;
    width: 7px;
    height: 7px;
    background: var(--cg-sage);
    margin-right: 10px;
  }
  h1 {
    font-size: clamp(42px, 5.4vw, 72px);
    line-height: 1.06;
    letter-spacing: -0.055em;
    font-weight: 550;
    margin: 0 0 28px;
  }
  .accent {
    color: var(--cg-accent);
  }
  .hero-lede {
    font-size: clamp(18px, 2vw, 23px);
    line-height: 1.5;
    max-width: 600px;
    margin: 0 0 18px;
  }
  .hero-detail {
    font-size: 15px;
    line-height: 1.85;
    color: var(--cg-ink-2);
    max-width: 590px;
    margin: 0 0 30px;
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    gap: 26px;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    font-size: 13px;
    font-weight: 600;
    min-height: 48px;
    border: 1px solid var(--cg-rule);
    transition: background 0.2s;
  }
  .primary {
    background: var(--cg-ink);
    color: var(--cg-paper);
    border-color: var(--cg-ink);
  }
  .primary:hover {
    background: #c9d2d1;
  }
  .secondary {
    background: #101417;
    color: var(--cg-ink);
  }
  .secondary:hover {
    background: var(--cg-paper-press);
  }
  .release {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 28px;
    font: 11px var(--sl-font-mono);
    color: var(--cg-ink-2);
  }
  .release span + span {
    border-left: 1px solid var(--cg-rule);
    padding-left: 18px;
  }
  .version-note {
    font-size: 12px;
    color: var(--cg-ink-2);
  }
  .version-note a {
    text-decoration: underline;
  }
  .hero-annotation {
    display: flex;
    justify-content: space-between;
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--cg-rule);
    margin-top: 72px;
    padding-top: 14px;
    font: 10px var(--sl-font-mono);
    letter-spacing: 0.08em;
    color: var(--cg-ink-2);
  }
  .integrations {
    padding: 28px max(24px, calc((100vw - 1200px) / 2));
    border-block: 1px solid var(--cg-rule);
    background: var(--cg-paper-2);
    display: flex;
    align-items: center;
    gap: 36px;
  }
  .integrations .eyebrow {
    margin: 0;
    min-width: 120px;
  }
  .agent-list {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    flex: 1;
  }
  .agent {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--cg-ink-2);
  }
  .agent-icon {
    width: 18px;
    height: 18px;
    display: inline-flex;
  }
  .agent-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .integrations > a {
    font-size: 12px;
    white-space: nowrap;
  }
  .section {
    padding: 96px max(24px, calc((100vw - 1200px) / 2));
    border-bottom: 1px solid var(--cg-rule);
    position: relative;
    scroll-margin-top: 24px;
  }
  .section-heading {
    max-width: 760px;
    margin-bottom: 44px;
  }
  .section-heading .eyebrow {
    margin-bottom: 20px;
  }
  h2 {
    font-size: clamp(30px, 3.7vw, 48px);
    line-height: 1.18;
    letter-spacing: -0.04em;
    font-weight: 500;
    margin: 0 0 20px;
  }
  .section-heading > p:last-of-type {
    font-size: 16px;
    line-height: 1.8;
    color: var(--cg-ink-2);
    max-width: 580px;
    margin: 0;
  }
  h3 {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--cg-rule);
    border: 1px solid var(--cg-rule);
  }
  .feature {
    background: var(--cg-paper);
    padding: 28px;
    display: flex;
    flex-direction: column;
    transition: background 0.2s;
  }
  .feature:hover {
    background: var(--cg-paper-press);
  }
  .feature-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }
  .feature-top .number {
    margin: 0 auto 0 0;
  }
  .feature-icon {
    height: 26px;
    width: 26px;
    color: var(--cg-steel);
  }
