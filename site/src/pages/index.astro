---
import '@fontsource-variable/archivo';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource-variable/oxanium/wght.css';
import '../styles/minimal-home.css';
import MinimalHome from '../components/MinimalHome.astro';
import { DOCS_SITE } from '../lib/brand';
import { ogImagePath } from '../lib/og-card.mjs';
import { pageLockScript } from '../lib/page-lock';

const description = 'Ax is a local-first native developer tool for code intelligence, persistent memory, MCP integration and policy-driven development. Install for macOS, Linux, Windows or WSL2.';
const ogImage = new URL(ogImagePath('/'), DOCS_SITE).href;
const pageLock = pageLockScript();
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={pageLock} />
    <link rel="icon" href="/favicon.svg" />
    <title>Ax — Your context. Your rules. Your control.</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="Ax — Your context. Your rules. Your control." />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#080a09" />
  </head>
  <body class="ax-landing">
    <MinimalHome />
  </body>
</html>
