# Settings for the ax remote MCP server (compose.yaml or the Podman Quadlet units).

# Public HTTPS address of this server, without a path. Point the domain's DNS at this
# host and open ports 80 and 443 first; Caddy then gets a certificate automatically.
# To try it on your own computer, use https://localhost (Caddy's local certificate).
AX_PUBLIC_URL=https://ax.example.com

# Git URL of the repository to serve. For a private repository, include a read-only
# token in the URL.
AX_REPO_URL=https://github.com/OWNER/REPO

# Key that clients send as "Authorization: Bearer <key>": at least 32 characters of
# letters, digits and ._~+/=- . Generate one with: openssl rand -hex 32
# The server refuses to start while this is empty.
AX_API_KEY=

# Optional:
# AX_REPO_REF=main          branch or tag to serve (default branch otherwise)
# AX_API_KEY_WRITE=1        let the key write memories and policy (read-only otherwise)
# AX_PROJECT_ID=project     the project part of the MCP URL
