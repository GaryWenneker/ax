{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "prebuild": "npm ci --include=dev --no-audit --no-fund",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/write-latest-version.mjs && astro build && node scripts/render-og.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "test": "node scripts/write-latest-version.mjs && node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.6",
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/oxanium": "^5.3.0",
    "@fontsource/bebas-neue": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "astro": "^7.3.8",
    "jose": "^5.9.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.2",
    "puppeteer": "^25.14.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6",
    "esbuild": "0.25.12"
  }
}
