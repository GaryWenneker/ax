{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Headless ax (slim) as an always-on Azure Container App: clones a repository, indexes it and serves it as a remote MCP server over HTTPS (ax-serve-repo). Clients connect to https://<app>/projects/<projectId>/mcp with Authorization: Bearer <apiKey>. The website serves a copy whose axVersion default is the newest release (site/scripts/write-azure-template.mjs)."
  },
  "parameters": {
    "repoUrl": {
      "type": "securestring",
      "metadata": {
        "description": "Git URL of the repository to serve. Stored as a secret, so a URL with a token for a private repository stays out of plain environment variables."
      }
    },
    "apiKey": {
      "type": "securestring",
      "minLength": 32,
      "metadata": {
        "description": "Bearer key MCP clients send (at least 32 characters: letters, digits and ._~+/=-). Generate one with: openssl rand -hex 32"
      }
    },
    "repoRef": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Branch or tag to serve. Leave empty for the default branch."
      }
    },
    "projectId": {
      "type": "string",
      "defaultValue": "project",
      "metadata": {
        "description": "Project ID in the MCP URL: https://<app>/projects/<projectId>/mcp"
      }
    },
    "allowWrites": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Let the API key write memories and policy. Off gives read-only context."
      }
    },
    "axVersion": {
      "type": "string",
      "defaultValue": "10.1.1",
      "metadata": {
        "description": "ax release without the leading v. The app runs ghcr.io/garywenneker/ax-slim:<version>-server."
      }
    },
    "appName": {
      "type": "string",
      "defaultValue": "ax-mcp",
      "minLength": 2,
      "maxLength": 32,
      "metadata": {
        "description": "Name of the Container App (lowercase letters, digits and hyphens). It becomes part of the public URL."
      }
    },
    "environmentName": {
      "type": "string",
      "defaultValue": "ax-env",
      "minLength": 2,
      "maxLength": 32,
      "metadata": {
        "description": "Name of the Container Apps environment. It is created in the selected resource group, or updated if it already exists there."
      }
    },
    "cpu": {
      "type": "string",
      "defaultValue": "1.0",
      "allowedValues": ["0.5", "1.0", "2.0"],
      "metadata": {
        "description": "vCPUs for the container. Memory is twice this in GiB (1, 2 or 4 Gi)."
      }
    },
    "startupMinutes": {
      "type": "int",
      "defaultValue": 40,
      "minValue": 5,
      "maxValue": 40,
      "metadata": {
        "description": "Minutes the app may take to clone and index the repository before it must answer /health (5-40, the most Container Apps allows). A start that takes longer is restarted and clones and indexes again, so pick a larger CPU for a large repository."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Region for all resources. Defaults to the resource group's region."
      }
    }
  },
  "variables": {
    "image": "[concat('ghcr.io/garywenneker/ax-slim:', parameters('axVersion'), '-server')]",
    "workspaceName": "[concat(parameters('environmentName'), '-logs')]",
    "environmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
    "memoryForCpu": {
      "0.5": "1Gi",
      "1.0": "2Gi",
      "2.0": "4Gi"
    },
    "baseEnv": [
      {
        "name": "AX_REPO_URL",
        "secretRef": "ax-repo-url"
      },
      {
        "name": "AX_API_KEY",
        "secretRef": "ax-api-key"
      },
      {
        "name": "AX_API_KEY_WRITE",
        "value": "[if(parameters('allowWrites'), '1', '0')]"
      },
      {
        "name": "AX_PROJECT_ID",
        "value": "[parameters('projectId')]"
      },
      {
        "name": "PORT",
        "value": "8080"
      }
    ],
    "refEnv": "[if(empty(parameters('repoRef')), json('[]'), createArray(createObject('name', 'AX_REPO_REF', 'value', parameters('repoRef'))))]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2022-10-01",
      "name": "[variables('workspaceName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[parameters('environmentName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName'))]"
      ],
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName')), '2022-10-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName')), '2022-10-01').primarySharedKey]"
          }
        }
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[variables('environmentId')]"
      ],
      "properties": {
        "environmentId": "[variables('environmentId')]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 8080,
            "transport": "http",
            "allowInsecure": false
          },
          "secrets": [
            {
              "name": "ax-repo-url",
              "value": "[parameters('repoUrl')]"
            },
            {
              "name": "ax-api-key",
              "value": "[parameters('apiKey')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "ax",
              "image": "[variables('image')]",
              "env": "[concat(variables('baseEnv'), createArray(createObject('name', 'AX_PUBLIC_URL', 'value', concat('https://', parameters('appName'), '.', reference(variables('environmentId'), '2024-03-01').defaultDomain))), variables('refEnv'))]",
              "resources": {
                "cpu": "[json(parameters('cpu'))]",
                "memory": "[variables('memoryForCpu')[parameters('cpu')]]"
              },
              "probes": [
                {
                  "type": "Startup",
                  "httpGet": {
                    "path": "/health",
                    "port": 8080
                  },
                  "periodSeconds": "[mul(parameters('startupMinutes'), 6)]",
                  "failureThreshold": 10
                },
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/health",
                    "port": 8080
                  },
                  "periodSeconds": 30
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          }
        }
      }
    }
  ],
  "outputs": {
    "mcpUrl": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.App/containerApps', parameters('appName')), '2024-03-01').configuration.ingress.fqdn, '/projects/', parameters('projectId'), '/mcp')]"
    },
    "image": {
      "type": "string",
      "value": "[variables('image')]"
    },
    "logsCommand": {
      "type": "string",
      "value": "[concat('az containerapp logs show --name ', parameters('appName'), ' --resource-group ', resourceGroup().name, ' --follow')]"
    }
  }
}
